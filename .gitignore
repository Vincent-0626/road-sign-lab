# Dataset: ~365 MB of archives plus ~52k extracted images.
# Recreate with: python -m src.cli prepare
data/

# Training artefacts. checkpoints/best.pt is force-added (see README) so the
# project can be evaluated without retraining.
checkpoints/*
!checkpoints/best.pt
results/run.log

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Ablation runs: keep the metrics, not the 1.2 MB checkpoints each produces.
ablations/**/*.pt

# Local connection helpers and screenshots are never part of a public repo.
read_login_ocr.ps1
authorize_server_key.ps1
secure_connect_prompt.py
temp_ssh_askpass.exe
gui_qa_temp.py
demo_qa.png
